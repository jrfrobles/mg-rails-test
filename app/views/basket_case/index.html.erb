<h1>Fruit Basket</h1>
<span class="data">raw data: <%= @fruits %></span>
<br />

<% next_order = params[:order] == "desc" ? "asc" : "desc" %>
 

<%= link_to "Order by Name #{next_order == 'desc' ?  '⬆︎' : '⬇︎' if @sorted_by == 'name' }", 
    basket_case_order_by_fruit_path(order: next_order), 
    class: "button"%>

<%= link_to "Order by Amount#{next_order == 'desc' ? '⬆︎' : '⬇︎' if @sorted_by == 'amount' }", 
    basket_case_order_by_amount_path(order: next_order),  
    class: "button"%>


<div class="container">
<%- @list_items.each do |fruit, amount| %>
  <p><%= fruit %> : <%= amount %></p>
<% end %>
</div>